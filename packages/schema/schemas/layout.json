{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "era": {
      "type": "string",
      "minLength": 1
    },
    "stations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "station_id": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "station_id",
          "x",
          "y"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "era",
    "stations"
  ],
  "additionalProperties": false
}
